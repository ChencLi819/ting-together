.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #0d141f;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
}

.go-btn {
  width: 150rpx;
}

.source-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.source-chip {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

.source-chip.active {
  background: linear-gradient(135deg, #38b6ff, #1273e6);
  border-color: transparent;
  color: #fff;
}

.source-edit {
  margin-left: auto;
  font-size: 22rpx;
  color: #7fd0ff;
}

.btn-hover {
  opacity: 0.8;
}

.history {
  padding: 28rpx 0 8rpx;
  flex-shrink: 0;
}

.history-title {
  margin-bottom: 16rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.08);
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
}

.tag-hover {
  background: rgba(255, 255, 255, 0.15);
}

.results {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
