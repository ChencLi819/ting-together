.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: radial-gradient(1000rpx 500rpx at 50% -5%, #10304a 0%, #0d141f 60%) no-repeat;
  overflow: hidden;
}

/* ---------------- 顶部 ---------------- */
.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.code-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
}

.chip-hover {
  opacity: 0.75;
}

.code-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.code-value {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.code-copy {
  font-size: 22rpx;
  color: #38b6ff;
}

.online {
  display: flex;
  align-items: center;
  margin-left: auto;
  gap: 8rpx;
  flex-shrink: 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #38b6ff, #1273e6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-left: -12rpx;
  border: 2rpx solid #0d141f;
}
.avatar:first-child {
  margin-left: 0;
}

.online-count {
  margin-left: 10rpx;
  min-width: 42rpx;
  white-space: nowrap;
  text-align: right;
}

.mode-btn {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.08);
  padding: 10rpx 18rpx;
  border-radius: 32rpx;
}

.leave-btn {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.06);
  padding: 10rpx 18rpx;
  border-radius: 32rpx;
}

/* ---------------- 中部舞台 ---------------- */
.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  overflow: hidden;
}

.disc-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.disc {
  /* 自适应：随视口高度缩放，限制在 [280rpx, 420rpx]，避免小屏溢出/大屏虚胖 */
  width: 28vh;
  height: 28vh;
  max-width: 420rpx;
  max-height: 420rpx;
  min-width: 280rpx;
  min-height: 280rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 10rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  background: #14273a;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: rgba(255, 255, 255, 0.25);
  background: linear-gradient(135deg, #14273a, #1d3a55);
}

.disc-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  margin: -30rpx 0 0 -30rpx;
  border-radius: 50%;
  background: #0d141f;
  border: 6rpx solid rgba(255, 255, 255, 0.25);
}

.loading-tip {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(0, 0, 0, 0.45);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}
.loading-tip.warn {
  color: #ffb35f;
}

.lyric {
  width: 100%;
  flex: 1;
  min-height: 0;
  height: auto;
  text-align: center;
  box-sizing: border-box;
}

.lyric-spacer {
  height: 50%;
}

.lyric-line {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 48rpx;
  font-size: 30rpx;
  line-height: 1.55;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: anywhere;
  color: rgba(255, 255, 255, 0.45);
  transition: color 0.2s;
}
.lyric-line.active {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.track-meta {
  flex-shrink: 0;
  margin-top: 16rpx;
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
  width: 100%;
  text-align: center;
}

.track-title {
  font-size: 38rpx;
  font-weight: 700;
}

.empty-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-request-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  color: #fff;
  background: linear-gradient(135deg, #38b6ff, #1273e6);
  box-shadow: 0 8rpx 30rpx rgba(18, 115, 230, 0.3);
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
}

/* ---------------- 进度条 ---------------- */
.progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.slider {
  flex: 1;
  margin: 0;
}

.time {
  font-size: 22rpx;
  min-width: 80rpx;
  text-align: center;
}

/* ---------------- 控制区 ---------------- */
.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
  padding: 20rpx 0 8rpx;
  flex-shrink: 0;
  position: relative;
}

.ctrl {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-hover {
  opacity: 0.7;
}

.ctrl-icon {
  font-size: 40rpx;
  color: #f3f3f8;
}

.ctrl.main {
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #38b6ff, #1273e6);
  box-shadow: 0 10rpx 40rpx rgba(18, 115, 230, 0.35);
}

.ctrl.main.disabled {
  opacity: 0.4;
}

.ctrl-icon.main-icon {
  font-size: 48rpx;
}

.request-btn {
  position: absolute;
  right: 8rpx;
  bottom: 16rpx;
  font-size: 26rpx;
  padding: 12rpx 34rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #38b6ff, #1273e6);
  box-shadow: 0 8rpx 30rpx rgba(18, 115, 230, 0.3);
}

.quality-btn {
  position: absolute;
  left: 8rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.08);
}

/* ---------------- 队列 / 聊天 ---------------- */
.panel-wrap {
  height: 420rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  overflow: hidden;
}

.tabs {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 0;
  gap: 36rpx;
  flex-shrink: 0;
}

.tab {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  padding-bottom: 14rpx;
  position: relative;
}

.tab.active {
  color: #fff;
  font-weight: 600;
}
.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #38b6ff;
}

.badge {
  margin-left: 8rpx;
  font-size: 20rpx;
  background: rgba(56, 182, 255, 0.2);
  color: #7fd0ff;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
}

.conn {
  margin-left: auto;
  font-size: 20rpx;
}
.conn.on {
  color: #6fe3a1;
}
.conn.off {
  color: #ffb35f;
}

.list {
  flex: 1;
  min-height: 0;
  padding: 12rpx 20rpx;
}

.empty-list {
  text-align: center;
  padding: 60rpx 0;
}

/* 聊天 */
.chat-list {
  padding-bottom: 0;
}

.msg {
  margin: 14rpx 0;
  display: flex;
  flex-direction: column;
}

.msg-sys {
  align-items: center;
}

.sys-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.bubble {
  max-width: 70%;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.msg-self {
  align-items: flex-end;
}
.msg-self .bubble {
  background: linear-gradient(135deg, #38b6ff, #1273e6);
}

.msg-other {
  align-items: flex-start;
}

.bubble-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}
.msg-self .bubble-name {
  color: rgba(255, 255, 255, 0.85);
}

.bubble-text {
  font-size: 28rpx;
  word-break: break-all;
}

.msg-time {
  font-size: 18rpx;
  margin-top: 4rpx;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 150rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.btn-hover {
  opacity: 0.8;
}
