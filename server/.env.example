# 复制为 server/.env 后按需修改；本文件作为样例入库，真实 .env 不入库
PORT=3100
HOST=0.0.0.0

# 日志级别：debug|info|warn|error
LOG_LEVEL=info

# 音乐源：qqmusic（默认，搜索/歌词主源）| netease | mock
# 播放地址解析自动走降级链：曲目自身来源 → qqmusic → netease
MUSIC_PROVIDER=qqmusic

# （可选）网易云自有账号凭据：填你账号的 MUSIC_U cookie 值。
# 配置后用该账号的 VIP 权益解析完整曲目（320k），试听片段会变为全曲。
# 获取方式：浏览器登录 music.163.com → F12 → Application → Cookies → 复制 MUSIC_U 的值。
# 注意：这是你的账号凭据，仅放 .env（已被 .gitignore 排除），不要提交/外传；账号长期未登录会过期。
# 不配置则保持游客态（部分热门曲仍可播，VIP 曲多为试听片段）。
NCM_COOKIE=

# （可选）插件导入管理令牌：设置后导入/更换音乐插件必须携带请求头 x-plugin-token。
# 公网部署时强烈建议设置（插件导入等于在服务端加载执行第三方 JS）。
# PLUGIN_IMPORT_TOKEN=一串足够长的随机字符串


# 对外暴露的 WS 地址（发给客户端的提示信息用，可空）
PUBLIC_WS_URL=

# 房间与消息行为参数（默认值见 src/config.js）
ROOM_MAX_USERS=8
ROOM_IDLE_MS=3600000
CHAT_RATE_WINDOW_MS=2000
CHAT_RATE_MAX=6
ENQUEUE_RATE_WINDOW_MS=10000
ENQUEUE_RATE_MAX=8
